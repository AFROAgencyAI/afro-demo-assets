          fillUtmsInForm(form);

          // Let Elementor submit normally; just "tap" the submit and POST to Apps Script in parallel
          form.addEventListener("submit", function () {
            try {
              // Refill UTMs right before sending
              fillUtmsInForm(form);

              const formData = new FormData(form);
