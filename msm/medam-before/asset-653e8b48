        const STORAGE_PREFIX = "cg_utm_"; // key prefix in localStorage (change if you want separate tracking)

        // 1. Capture UTM params from URL and store in localStorage
        function storeUtmsFromUrl() {
          const params = new URLSearchParams(window.location.search);

          UTM_KEYS.forEach(function (key) {
            const value = params.get(key);
            if (value !== null && value !== "") {
              localStorage.setItem(STORAGE_PREFIX + key, value);
            }
          });
        }

        // 2. Fill UTM hidden fields in the Elementor form from localStorage
        function fillUtmsInForm(form) {
          UTM_KEYS.forEach(function (key) {
            const stored = localStorage.getItem(STORAGE_PREFIX + key);
            if (!stored) return;

            // Elementor field names: form_fields[utm_source], etc.
            const selector = 'input[name="form_fields[' + key + ']"]';
            const input = form.querySelector(selector);
            if (input) {
              input.value = stored;
            }
          });
