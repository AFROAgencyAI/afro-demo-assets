<script>
/**
 * Force visible success when backend actually succeeded (bypassing false “Webhook” banner).
 * Also hides the generic error if resp.success is true.
 */
(function(){
  function showForcedSuccess(){
    var form = document.querySelector('.elementor-form');
    if(!form) return;
    if(!form.querySelector('.elementor-message-success')){
      var div = document.createElement('div');
      div.className='elementor-message elementor-message-success';
      div.style.marginBottom='15px';
      div.textContent='Thank you! Your request has been received.';
      form.prepend(div);
    }
    // Remove any existing generic error
    document.querySelectorAll('.elementor-message-danger').forEach(e=>{
      if(/Webhook/.test(e.textContent)) e.remove();
    });
  }

  // Intercept Elementor AJAX
  const origXhr = window.XMLHttpRequest;
  function hijack(){
    const send = this.send;
    this.send = function(body){
      if(body && typeof body === 'string' && body.indexOf('action=elementor_pro_forms_send_form') !== -1){
        this.addEventListener('load', function(){
          try{
            var resp = JSON.parse(this.responseText);
            if(resp && resp.success){
              showForcedSuccess();
            }
          }catch(e){}
        });
      }
      return send.apply(this, arguments);
    };
  }
  window.XMLHttpRequest = function(){ const x = new origXhr(); hijack.call(x); return x; };

  // Also hook fetch (Elementor sometimes uses jQuery, but for safety)
  const origFetch = window.fetch;
  if(origFetch){
    window.fetch = function(){
      return origFetch.apply(this, arguments).then(res=>{
        try{
          const clone = res.clone();
          clone.text().then(t=>{
            if(t && t.indexOf('"success":true') !== -1 && t.indexOf('elementor_pro_forms_send_form') !== -1){
              showForcedSuccess();
            }
          });
        }catch(e){}
        return res;
      });
    };
  }
})();
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const params = new URLSearchParams(window.location.search);
    const utmFields = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];

    utmFields.forEach(key => {
        let value = params.get(key) || localStorage.getItem(key);
        if (params.get(key)) localStorage.setItem(key, params.get(key));
        const input = document.querySelector(`input[name="${key}"]`);
        if (input && value) input.value = value;
    });
});
</script>


